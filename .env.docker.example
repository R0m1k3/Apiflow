# Copier en .env.docker et remplir les valeurs
# .env.docker est exclu du git (contient les mots de passe)

DB_HOST=192.168.184.254
DB_PORT=1433
DB_NAME=foirfouille
# Login en lecture seule (voir DEPLOIEMENT.md) — ne plus utiliser sa
DB_USER=ff_reader
DB_PASSWORD=CHANGE_ME

PG_HOST=postgres
PG_PORT=5432
PG_DB=foirfouille
PG_USER=ff_api
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Délai max d'une requête SQL (ms)
PG_STATEMENT_TIMEOUT_MS=30000
# Taille du pool de connexions
PG_POOL_MAX=10

API_PORT=3000

# ── Sécurité API ────────────────────────────────────────────────
# Clés d'API autorisées, séparées par des virgules (en-tête X-API-Key ou Authorization: Bearer).
# Générer une clé : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# OBLIGATOIRE : si vide, l'API refuse de démarrer.
API_KEYS=

# Accès libre sans clé d'API (déconseillé : développement ou réseau isolé uniquement).
# Pris en compte seulement si API_KEYS est vide ; /api/health renvoie alors auth:"disabled".
ALLOW_NO_AUTH=false

# Origines autorisées en CORS (séparées par des virgules, '*' = toutes). Vide = pas d'en-têtes CORS.
CORS_ORIGINS=

# Requêtes max par minute et par IP client
RATE_LIMIT_PER_MIN=600

# Proxys de confiance pour X-Forwarded-For (nginx → frp → conteneur)
TRUST_PROXY=loopback, linklocal, uniquelocal

# Durée du cache mémoire des réponses GET (secondes, 0 = désactivé)
CACHE_TTL_SEC=300

# Exposer /api/schema (introspection de la base, derrière l'authentification)
EXPOSE_SCHEMA=false

# Exposition des ports sur l'hôte (127.0.0.1 = fermé au réseau local)
API_BIND=0.0.0.0
SYNC_BIND=0.0.0.0

# ── Service sync ────────────────────────────────────────────────
# Heure de la sync quotidienne (cron, heure de Paris)
SYNC_CRON=45 6 * * *
# Dashboard http://<serveur>:3001 — désactivé (503) tant que ces deux variables sont vides
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Webhook d'alerte (Slack / Discord / Mattermost) en cas d'erreur de sync — optionnel
ALERT_WEBHOOK_URL=
